# =============================================================================
# LealFinance - environment configuration
# Copy this file to `.env` and adjust values for your homelab.
# =============================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
DEFAULT_CURRENCY=BRL
DEFAULT_LOCALE=pt-BR

# --- Postgres ------------------------------------------------------------------
POSTGRES_USER=lealfinance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lealfinance
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=55433
# The URL is assembled from the pieces above when unset. For commands run on
# the host (outside Compose), override it with localhost and the published
# host port, for example:
# DATABASE_URL=postgresql+psycopg://lealfinance:change-me@localhost:55433/lealfinance

# --- Redis (Celery broker + result backend) -----------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_HOST_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# --- API -----------------------------------------------------------------------
API_SECRET_KEY=change-me-to-a-random-64-char-string
API_CORS_ORIGINS=http://localhost:4200

# --- Auth / sessions -------------------------------------------------------------
# API_SECRET_KEY (above) also peppers session/invitation token hashes at rest -
# rotating it invalidates every session and pending invitation.
SESSION_TTL_DAYS=30
INVITATION_TTL_DAYS=7

# --- Web (published port on the host) ------------------------------------------
WEB_PORT=8081

# --- Published images (only used with docker-compose.prod.yml) -----------------
# Image tag to pull from ghcr.io/leallab/lealfinance-{api,web} - see
# docs/homelab-deploy.md#deploy-from-published-images. Set by the release
# workflow's workflow_dispatch input; "latest" always exists once at least
# one release has run.
# TAG=latest

# --- AI Agents (optional, off by default - zero cost when disabled) ------------
AGENTS_ENABLED=false
# Uncomment to actually start the agents service:
# COMPOSE_PROFILES=agents
COMPOSE_PROFILES=

# --- Currency conversion (optional) ---------------------------------------------
# Free key from https://openexchangerates.org/signup/free. Rates are fetched
# on-demand and cached for the day. Without a key, cross-currency amounts
# fall back to a 1:1 rate with a warning flag (see docs/money-and-currency.md).
OPENEXCHANGERATES_APP_ID=
