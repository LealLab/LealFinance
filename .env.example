# Copy this file to `.env` before starting the project.
# Replace POSTGRES_PASSWORD and API_SECRET_KEY before using production data.

# General defaults
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
DEFAULT_CURRENCY=BRL
DEFAULT_LOCALE=pt-BR

# PostgreSQL
# POSTGRES_HOST/PORT are used inside Compose. POSTGRES_HOST_PORT is used when
# a native command or the development override connects from the host machine.
POSTGRES_USER=lealfinance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lealfinance
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=55433
# `task backend:test` uses this database instead of POSTGRES_DB and creates it
# on first run. Must end in `_test`.
# POSTGRES_TEST_DB=lealfinance_test

# Redis
# REDIS_HOST/PORT are used inside Compose. REDIS_HOST_PORT is the host port.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_HOST_PORT=6379

# API and sessions
API_SECRET_KEY=change-me-to-a-random-64-char-string
# Local Angular development runs on port 4200.
API_CORS_ORIGINS=http://localhost:4200
SESSION_TTL_DAYS=30
INVITATION_TTL_DAYS=7
# How long "trust this device" skips the two-factor prompt on that browser.
TRUSTED_DEVICE_TTL_DAYS=30

# Web port published on the host
WEB_PORT=8081

# Optional: use published images instead of building from source. Release
# tags are v-prefixed; defaults to latest when unset.
# TAG=v1.2.3

# Checks GitHub for newer releases and shows admins an in-app banner.
# Anonymous, no instance data sent. Set false to disable outbound requests.
UPDATE_CHECK_ENABLED=true

# Optional AI providers. Disabled unless AGENTS_ENABLED=true.
# The agents Compose profile also starts the MCP server on port 8001 (unpublished).
# External MCP clients authenticate with a per-user token from POST /api/v1/agents/mcp-token.
AGENTS_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=
AGENTS_DEFAULT_PROVIDER=
# Set COMPOSE_PROFILES=agents to start the bundled Ollama container.
COMPOSE_PROFILES=

# Optional exchange-rate provider (Open Exchange Rates). Without a key,
# cross-currency rates use a flagged 1:1 fallback. Setting it also enables the
# scheduled rate refresh and the nightly fallback-conversion backfill (the
# worker and beat containers read this too). Recreate those containers after
# changing it - `docker compose restart` does not re-read .env.
OPENEXCHANGERATES_APP_ID=

# Optional market-data provider credentials. These are instance-wide fallbacks
# for users who have not linked their own key; live quotes degrade gracefully.
TWELVE_DATA_API_KEY=
BRAPI_TOKEN=
